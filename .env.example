# Production database. Prefer the provider's pooled/PgBouncer URL.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME

# Prevent an accidental fallback to the local SQLite file in production.
REQUIRE_POSTGRES=1

# Size this to the database/provider connection limit and worker count.
POSTGRES_POOL_MIN_CONN=1
POSTGRES_POOL_MAX_CONN=12
POSTGRES_POOL_WAIT_SECONDS=5
DATABASE_TIMEZONE=Asia/Jerusalem

# Use a stable, randomly generated value in production.
SECRET_KEY=replace-with-a-long-random-secret
