# Production database. Prefer the provider's pooled/PgBouncer URL.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME

# Prevent an accidental fallback to the local SQLite file in production.
REQUIRE_POSTGRES=1
CATALOG_SYNC_ENABLED=1
CATALOG_SYNC_HOUR=3
CATALOG_SYNC_STARTUP_DELAY=20
CATALOG_PAGE_REQUEST_INTERVAL=1.0
CATALOG_RETRY_ATTEMPTS=5
CATALOG_RETRY_BASE_SECONDS=15
CATALOG_EAN_REQUEST_INTERVAL=1.2
CATALOG_EAN_MAX_ATTEMPTS=3

# Size this to the database/provider connection limit and worker count.
POSTGRES_POOL_MIN_CONN=1
POSTGRES_POOL_MAX_CONN=12
POSTGRES_POOL_WAIT_SECONDS=5
DATABASE_TIMEZONE=Asia/Jerusalem

# Use a stable, randomly generated value in production.
SECRET_KEY=replace-with-a-long-random-secret

# Automatic ITAY BRANDS product-image synchronization.
PRODUCT_IMAGE_SYNC_ENABLED=1
PRODUCT_IMAGE_SYNC_INTERVAL=0.6
PRODUCT_IMAGE_SYNC_TIMEOUT=15
DAILY_MISSING_FLOOR_RESET_ENABLED=1
LOCATION_INACTIVITY_MONTHS=3
DAILY_RESET_TIMEZONE=Asia/Jerusalem
MISSING_FLOOR_RESET_HOUR=6
